---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<footer class="footer">
  <span>© {new Date().getFullYear()} {site.name}</span>
  <span class="end">
    <span>Set in Inter Tight</span>
    <a href="/licenses.txt">Licenses</a>
    <a href="#top">Back to top <Icon name="arrow-up" size={16} /></a>
  </span>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    padding: 12px 0 32px;
    border-top: var(--hairline);
    font-size: 14px;
    color: var(--muted);
  }
  .end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
  }
  /* Comfortable tap targets for small text links. */
  .end a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }
  .end a:hover {
    color: var(--accent);
  }
</style>
