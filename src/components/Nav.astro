---
import { site } from '../data/site';
import { hasResume } from '../data/resume';
import Icon from './Icon.astro';

interface Props {
  /** Prefix for in-page anchors: '' on the homepage, '/' elsewhere. */
  base?: string;
  hasWriting?: boolean;
}
const { base = '', hasWriting = false } = Astro.props;

const items = [
  { label: 'Index', href: `${base}#index` },
  hasResume && { label: 'Experience', href: `${base}#experience` },
  hasWriting && { label: 'Writing', href: `${base}#writing` },
  hasResume && { label: 'Resume', href: '/resume' },
  { label: 'About', href: `${base}#about` },
  { label: 'Contact', href: `${base}#contact` },
].filter(Boolean) as { label: string; href: string }[];
---

<nav aria-label="Primary" class="nav">
  <a href={base ? '/' : '#top'} class="brand">{site.initials}</a>
  <div class="nav-links">
    {items.map((i) => <a href={i.href}>{i.label}</a>)}
    <button type="button" class="theme" aria-label="Switch to dark theme" hidden>
      <Icon name="moon" size={20} class="to-dark" />
      <Icon name="sun" size={20} class="to-light" />
    </button>
  </div>
</nav>

<script>
  // Flip between light and dark, starting from whatever is showing now
  // (a saved choice, or the system setting). The button needs JS, so it
  // stays hidden without it.
  const root = document.documentElement;
  const dark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  document.querySelectorAll<HTMLButtonElement>('.theme').forEach((btn) => {
    const label = () => btn.setAttribute('aria-label', `Switch to ${dark() ? 'light' : 'dark'} theme`);
    btn.hidden = false;
    label();
    btn.addEventListener('click', () => {
      root.dataset.theme = dark() ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {}
      label();
    });
  });
</script>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 24px 0;
    border-bottom: var(--rule);
    font-family: var(--display);
    font-weight: 500;
    font-size: 16px;
  }
  .nav a {
    text-decoration: none;
  }
  .brand {
    font-weight: 700;
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
  .nav-links a {
    padding: 12px 14px;
  }
  .theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: 6px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .theme[hidden] {
    display: none;
  }
  .theme {
    color: var(--ink);
  }
  .theme:hover {
    color: var(--accent);
  }
  /* Moon in light (switch to dark), sun in dark, whichever way dark was chosen. */
  .theme :global(.to-light) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme :global(.to-light) {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme :global(.to-dark) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme :global(.to-light) {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme :global(.to-dark) {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .nav-links a {
      padding: 12px 8px;
    }
  }
</style>
